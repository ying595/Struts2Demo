rride\n    public String execute() throws Exception {\n        // 判断用户名是否已经注册\n        boolean hasUser = userList.stream()\n                .anyMatch(u -> u.getUsername().equals(user.getUsername()));\n        if(hasUser){\n            addActionError(\"该用户名已被注册！\");\n            return ERROR;\n        }\n        // 判断用户名密码非空\n        if(user.getUsername() == null || user.getUsername().trim().isEmpty()\n                || user.getPassword() == null || user.getPassword().trim().isEmpty()){\n            addActionError(\"用户名和密码不能为空！\");\n            return ERROR;\n        }\n        userList.add(user);\n        return SUCCESS;\n    }\n}\n\n```\n\n\n```java:D:/JavaProjects/Struts2Demo/src/main/java/com/demo/entity/UserInfo.java\npackage com.demo.entity;\n\npublic class UserInfo {\n    private String username;\n    private String password;\n\n    public String getUsername() {\n        return username;\n    }\n\n    public void setUsername(String username) {\n        this.username = username;\n    }\n\n    public String getPassword() {\n        return password;\n    }\n\n    public void setPassword(String password) {\n        this.password = password;\n    }\n}\n\n```\n\n\n```xml:D:/JavaProjects/Struts2Demo/src/main/resources/struts.xml\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE struts PUBLIC\n        \"-//Apache Software Foundation//DTD Struts Configuration 2.5//EN\"\n        \"http://struts.apache.org/dtds/struts-2.5.dtd\">\n<struts>\n    <package name=\"demo\" extends=\"struts-default\">\n        <!-- 登录action -->\n        <action name=\"login\" class=\"com.demo.action.LoginAction2\">\n            <result name=\"success\">/welcome.jsp</result>\n            <result name=\"error\">/login.jsp</result>\n        </action>\n        <!-- 注册action -->\n        <action name=\"register\" class=\"com.demo.action.RegisterAction\">\n            <result name=\"success\">/login.jsp</result>\n            <result name=\"error\">/register.jsp</result>\n        </action>\n    </package>\n</struts>\n\n```\n\n\n```xml:D:/JavaProjects/Struts2Demo/src/main/webapp/WEB-INF/web.xml\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<web-app xmlns=\"http://xmlns.jcp.org/xml/ns/javaee\"\n         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://xmlns.jcp.org/xml/ns/javaee\n         https://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd\"\n         version=\"4.0\">\n\n  <filter>\n    <filter-name>struts2</filter-name>\n    <filter-class>org.apache.struts2.dispatcher.filter.StrutsPrepareAndExecuteFilter</filter-class>\n  </filter>\n  <filter-mapping>\n    <filter-name>struts2</filter-name>\n    <url-pattern>/*</url-pattern>\n  </filter-mapping>\n\n</web-app>\n\n```\n\n\n```jsp:D:/JavaProjects/Struts2Demo/src/main/webapp/hello.jsp\n<%@ page language=\"java\" contentType=\"text/html; charset=UTF-8\"\n    pageEncoding=\"UTF-8\"%>\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Struts2 HelloWorld</title>\n</head>\n<body>\n    <h2>第一个Struts2程序</h2>\n    <p>${message}</p>\n</body>\n</html>\n\n```\n\n\n```jsp:D:/JavaProjects/Struts2Demo/src/main/webapp/index.jsp\n<html>\n<body>\n<h2>Hello World!</h2>\n</body>\n</html>\n\n```\n\n\n```jsp:D:/JavaProjects/Struts2Demo/src/main/webapp/login.jsp\n<%@ page contentType=\"text/html;charset=UTF-8\" language=\"java\" %>\n<%@ taglib prefix=\"s\" uri=\"/struts-tags\" %>\n<html>\n<head>\n    <title>用户登录</title>\n</head>\n<body>\n    <h2>用户登录</h2>\n    <s:actionerror/>\n    <s:form action=\"login\">\n        <s:textfield name=\"user.username\" label=\"用户名\"/>\n        <s:password name=\"user.password\" label=\"密码\"/>\n        <s:submit value=\"登录\"/>\n    </s:form>\n    <br/>\n    <a href=\"register.jsp\">没有账号？点击注册</a>\n</body>\n</html>\n\n```\n\n\n```jsp:D:/JavaProjects/Struts2Demo/src/main/webapp/welcome.jsp\n<%@ page contentType=\"text/html;charset=UTF-8\" language=\"java\" %>\n<html>\n<head>\n    <title>欢迎页面</title>\n</head>\n<body>\n    <h2>✅ 登录成功！</h2>\n    <p>